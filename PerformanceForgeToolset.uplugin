{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "0.1.0",
  "FriendlyName": "PerformanceForge Toolset",
  "Description": "Planning sessions, running them, and choosing takes - as Model Context Protocol tools. Every function forwards to PerformanceForge's subsystem and adds nothing, so a director's whole flow is reachable by an agent as well as by the panel.",
  "Category": "Automation Forge",
  "CreatedBy": "Bojan Andrejek",
  "CreatedByURL": "https://kovati.dev",
  "DocsURL": "",
  "MarketplaceURL": "",
  "SupportURL": "",
  "EditorOnly": true,
  "EnabledByDefault": false,
  "CanContainContent": false,
  "IsBetaVersion": false,
  "IsExperimentalVersion": true,
  "Installed": false,
  "Modules": [
    {
      "Name": "PerformanceForgeToolset",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "TargetAllowList": [
        "Editor"
      ]
    }
  ],
  "Plugins": [
    {
      "Name": "PerformanceForge",
      "Enabled": true,
      "Comment": "The capability this exposes, and the types in its signatures."
    },
    {
      "Name": "ToolsetRegistry",
      "Enabled": true,
      "Comment": "Not ModelContextProtocol: MCP is one transport reading the registry, and coupling to it would be backwards."
    }
  ]
}
